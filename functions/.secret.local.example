# PropMatch AI — Local Secrets Configuration Template
# Instructions:
# 1. Copy this file to `functions/.secret.local`:
#    cp functions/.secret.local.example functions/.secret.local
# 2. Replace YOUR_GEMINI_API_KEY_HERE with your genuine Gemini API key from Google AI Studio:
#    https://aistudio.google.com/app/apikey
# 3. DO NOT commit `functions/.secret.local` to version control (it is excluded by .gitignore).
#
# Google Gemini API
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Meta Developer App & Graph API Configuration (Phase 5.1 & 5.1A)
# Obtained from Meta Developer App Dashboard > App settings > Basic:
META_APP_ID=YOUR_META_APP_ID_HERE
META_APP_SECRET=YOUR_META_APP_SECRET_HERE

# Custom random token chosen by developer for webhook handshake validation:
META_WEBHOOK_VERIFY_TOKEN=YOUR_META_WEBHOOK_VERIFY_TOKEN_HERE

# Optional: User or Page Access Token for running live connection test scripts
META_USER_ACCESS_TOKEN=YOUR_OPTIONAL_TEST_TOKEN_HERE

